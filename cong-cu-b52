    function renderSicbo(container, data, isStale, errMsg) {
        const xx = [data.Xuc_xac_1, data.Xuc_xac_2, data.Xuc_xac_3];
        const tong = data.Tong;
        const phien = data.Phien;
        const laChan = tong % 2 === 0;
        const laTai = tong >= 11;
        const chanLe = laChan ? 'Chẵn' : 'Lẻ';
        const taiXiu = laTai ? 'Tài' : 'Xỉu';
        const chanLeClass = laChan ? 'chan' : 'le';
        const taiXiuClass = laTai ? 'tai' : 'xiu';

        const isNewPhien = lastSicboPhien !== null && lastSicboPhien !== phien;

        if (phien !== lastSicboPhien) {
            const txSym = laTai ? 'T' : 'X';
            const clSym = laChan ? 'C' : 'L';
            const added = pushHistory(sicboHistory, { phien, tong, tx: txSym, cl: clSym });
            if (added) saveHistory(STORAGE_KEYS.SICBO_HISTORY, sicboHistory);
            lastSicboPhien = phien;
            saveLastPhien(STORAGE_KEYS.SICBO_LAST_PHIEN, phien);
        }

        const txArr = sicboHistory.map(h => h.tx);
        const clArr = sicboHistory.map(h => h.cl);

        const txAnalysis = analyzeSignals(txArr, 'Tài', 'Xỉu', 'T', 'X');
        const clAnalysis = analyzeSignals(clArr, 'Chẵn', 'Lẻ', 'C', 'L');

        let txMainSym, txMainName, txMainConf, txMainSource;
        if (txAnalysis.consensus) {
            txMainSym = txAnalysis.consensus.sym;
            txMainName = txAnalysis.consensus.name;
            txMainConf = txAnalysis.consensus.confidence;
            txMainSource = `${txAnalysis.consensus.totalSignals} thuật toán`;
        } else {
            txMainSym = laTai ? 'X' : 'T';
            txMainName = laTai ? 'Xỉu' : 'Tài';
            txMainConf = '—'; txMainSource = 'Đảo cầu';
        }
        const txColor = txMainSym === 'T' ? '#f5b042' : '#4d7cfe';
        const txBarPct = txAnalysis.consensus ? (txMainSym === 'T' ? txAnalysis.consensus.rawScoreA : txAnalysis.consensus.rawScoreB) * 100 : 50;

        let clMainSym, clMainName, clMainConf, clMainSource;
        if (clAnalysis.consensus) {
            clMainSym = clAnalysis.consensus.sym;
            clMainName = clAnalysis.consensus.name;
            clMainConf = clAnalysis.consensus.confidence;
            clMainSource = `${clAnalysis.consensus.totalSignals} thuật toán`;
        } else {
            clMainSym = laChan ? 'L' : 'C';
            clMainName = laChan ? 'Lẻ' : 'Chẵn';
            clMainConf = '—'; clMainSource = 'Đảo cầu';
        }
        const clColor = clMainSym === 'C' ? '#31c48d' : '#e85d7a';
        const clBarPct = clAnalysis.consensus ? (clMainSym === 'C' ? clAnalysis.consensus.rawScoreA : clAnalysis.consensus.rawScoreB) * 100 : 50;

        let txSignalRows = '';
        if (txAnalysis.signals.length === 0) {
            txSignalRows = '<tr><td colspan="4" style="color:#8b94a8; text-align:center;">Chờ thêm phiên</td></tr>';
        } else {
            for (const s of txAnalysis.signals) {
                const sigClass = s.sym === 'T' ? 'signal-tai' : 'signal-xiu';
                txSignalRows += `<tr>
                    <td class="algo-name">${s.name}</td>
                    <td class="algo-signal ${sigClass}">${s.sym === 'T' ? 'Tài' : 'Xỉu'}</td>
                    <td class="algo-weight">${(s.weight*100).toFixed(0)}%</td>
                    <td style="font-size:0.7rem; color:#8b94a8;" title="${s.note}">ⓘ</td>
                </tr>`;
            }
        }

        let clSignalRows = '';
        if (clAnalysis.signals.length === 0) {
            clSignalRows = '<tr><td colspan="4" style="color:#8b94a8; text-align:center;">Chờ thêm phiên</td></tr>';
        } else {
            for (const s of clAnalysis.signals) {
                const sigClass = s.sym === 'C' ? 'signal-chan' : 'signal-le';
                clSignalRows += `<tr>
                    <td class="algo-name">${s.name}</td>
                    <td class="algo-signal ${sigClass}">${s.sym === 'C' ? 'Chẵn' : 'Lẻ'}</td>
                    <td class="algo-weight">${(s.weight*100).toFixed(0)}%</td>
                    <td style="font-size:0.7rem; color:#8b94a8;" title="${s.note}">ⓘ</td>
                </tr>`;
            }
        }

        const historyChipsTx = sicboHistory.slice(-20).map(h => {
            const cls = h.tx === 'T' ? 'chip-t' : 'chip-x';
            return `<span class="history-chip ${cls}" title="Phiên ${h.phien} - Tổng ${h.tong}">${h.tx}</span>`;
        }).join('');
        const historyChipsCl = sicboHistory.slice(-20).map(h => {
            const cls = h.cl === 'C' ? 'chip-c' : 'chip-l';
            return `<span class="history-chip ${cls}" title="Phiên ${h.phien} - Tổng ${h.tong}">${h.cl}</span>`;
        }).join('');

        const totalHist = sicboHistory.length;
        const countT = sicboHistory.filter(h => h.tx === 'T').length;
        const countC = sicboHistory.filter(h => h.cl === 'C').length;
        const storageBytes = (localStorage.getItem(STORAGE_KEYS.SICBO_HISTORY) || '').length;
        const storageKB = (storageBytes / 1024).toFixed(1);

        const statusDot = isStale ? 'err' : 'ok';
        const statusText = isStale ? `⚠️ Mất kết nối — dùng dữ liệu cũ` : '✅ API hoạt động';

        container.innerHTML = `
            ${isNewPhien && !isStale ? '<div class="new-badge">PHIÊN MỚI</div>' : ''}
            <div class="api-status">
                <span class="api-dot ${statusDot}"></span>
                <span>${statusText}</span>
            </div>
            ${isStale ? `<div class="warning">⚠️ Không kết nối được API (${errMsg}). Đang hiển thị dữ liệu cuối cùng đã lưu.</div>` : ''}
            <div class="toggle-row">
                <span>🤖 Tự động cập nhật</span>
                <label class="switch">
                    <input type="checkbox" ${autoRefresh ? 'checked' : ''} onchange="toggleAuto(this.checked)">
                    <span class="slider"></span>
                </label>
            </div>

            <div class="dice-area">
                ${xx.map(v => `<div class="dice">${v}</div>`).join('')}
            </div>
            <div class="info-row"><span>Phiên hiện tại</span><strong>#${phien}</strong></div>
            <div class="info-row"><span>Tổng 3 xúc xắc</span><strong>${tong}</strong></div>
            <div class="info-row">
                <span>Kết quả phiên này</span>
                <span>
                    <span class="badge ${taiXiuClass}">${taiXiu}</span>
                    <span class="badge ${chanLeClass}" style="margin-left:6px;">${chanLe}</span>
                </span>
            </div>

            <div class="dual-prediction">
                <div class="dual-box">
                    <div class="mp-label">🎯 Dự đoán Tài/Xỉu</div>
                    <div class="mp-value">
                        <span style="color:${txColor}; text-shadow: 0 0 25px ${txColor}66;">${txMainName.toUpperCase()}</span>
                        <span class="dot" style="background:${txColor};"></span>
                    </div>
                    <div class="mp-meta">
                        <span>Tin cậy: <b>${txMainConf}</b></span>
                        <span>Nguồn: <b>${txMainSource}</b></span>
                    </div>
                    <div class="mp-bar">
                        <div class="mp-bar-fill" style="width:${txBarPct}%;"></div>
                    </div>
                </div>
                <div class="dual-box">
                    <div class="mp-label">🎯 Dự đoán Chẵn/Lẻ</div>
                    <div class="mp-value">
                        <span style="color:${clColor}; text-shadow: 0 0 25px ${clColor}66;">${clMainName.toUpperCase()}</span>
                        <span class="dot" style="background:${clColor};"></span>
                    </div>
                    <div class="mp-meta">
                        <span>Tin cậy: <b>${clMainConf}</b></span>
                        <span>Nguồn: <b>${clMainSource}</b></span>
                    </div>
                    <div class="mp-bar">
                        <div class="mp-bar-fill chan-fill" style="width:${clBarPct}%;"></div>
                    </div>
                </div>
            </div>

            <h3>📊 Tín hiệu Tài/Xỉu (${txAnalysis.signals.length} thuật toán)</h3>
            <table class="algo-table">
                <thead><tr><th>Thuật toán</th><th>Tín hiệu</th><th>Trọng số</th><th></th></tr></thead>
                <tbody>${txSignalRows}</tbody>
            </table>

            <h3>📊 Tín hiệu Chẵn/Lẻ (${clAnalysis.signals.length} thuật toán)</h3>
            <table class="algo-table">
                <thead><tr><th>Thuật toán</th><th>Tín hiệu</th><th>Trọng số</th><th></th></tr></thead>
                <tbody>${clSignalRows}</tbody>
            </table>

            <h3>💾 Lịch sử vĩnh viễn (${totalHist} phiên)</h3>
            <div class="history-strip">${historyChipsTx || '<span style="color:#8b94a8; font-size:0.75rem;">Chưa có lịch sử</span>'}</div>
            <div class="history-count">T/X: Tài ${countT} — Xỉu ${totalHist-countT}</div>
            <div class="history-strip" style="margin-top:4px;">${historyChipsCl || ''}</div>
            <div class="history-count">C/L: Chẵn ${countC} — Lẻ ${totalHist-countC}</div>
            <div class="storage-info">💿 Dung lượng lưu: ${storageKB} KB — không giới hạn số phiên</div>

            <div class="status">Cập nhật: ${new Date().toLocaleTimeString('vi-VN')}</div>
            <button onclick="fetchSicbo()">🔄 Làm mới ngay</button>
            <div class="btn-row">
                <button class="small-btn" onclick="exportHistory('sicbo')">⬇️ Xuất</button>
                <button class="small-btn" onclick="importHistory('sicbo')">⬆️ Nhập</button>
                <button class="small-btn" onclick="clearHistory('sicbo')" style="background:rgba(232,93,122,0.2);">🗑️ Xóa</button>
            </div>
        `;

        if (isNewPhien && !isStale) playNewSessionSound();
    }

    // ============================================================
    //  XUẤT / NHẬP / XÓA
    // ============================================================
    function exportHistory(type) {
        const data = type === 'taixiu' ? taiXiuHistory : sicboHistory;
        const json = JSON.stringify(data, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `lich-su-${type}-${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
    }

    function importHistory(type) {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.json';
        input.onchange = (e) => {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = (ev) => {
                try {
                    const imported = JSON.parse(ev.target.result);
                    if (!Array.isArray(imported)) throw new Error('Dữ liệu không hợp lệ');
                    imported.sort((a, b) => a.phien - b.phien);
                    if (type === 'taixiu') {
                        taiXiuHistory = imported;
                        saveHistory(STORAGE_KEYS.TAIXIU_HISTORY, taiXiuHistory);
                        fetchTaiXiu();
                    } else {
                        sicboHistory = imported;
                        saveHistory(STORAGE_KEYS.SICBO_HISTORY, sicboHistory);
                        fetchSicbo();
                    }
                    alert(`Đã nhập ${imported.length} phiên ${type}`);
                } catch (err) {
                    alert('Lỗi nhập: ' + err.message);
                }
            };
            reader.readAsText(file);
        };
        input.click();
    }

    function clearHistory(type) {
        if (!confirm(`Xóa toàn bộ lịch sử ${type}?`)) return;
        if (type === 'taixiu') {
            taiXiuHistory = [];
            saveHistory(STORAGE_KEYS.TAIXIU_HISTORY, []);
            fetchTaiXiu();
        } else {
            sicboHistory = [];
            saveHistory(STORAGE_KEYS.SICBO_HISTORY, []);
            fetchSicbo();
        }
    }

    // ============================================================
    //  ĐIỀU KHIỂN
    // ============================================================
    let autoRefresh = true;
    let refreshInterval = null;

    function toggleAuto(on) {
        autoRefresh = on;
        if (refreshInterval) { clearInterval(refreshInterval); refreshInterval = null; }
        if (on) {
            refreshInterval = setInterval(() => {
                fetchTaiXiu();
                fetchSicbo();
            }, 8000);
        }
    }

    function init() {
        fetchTaiXiu();
        fetchSicbo();
        toggleAuto(true);
    }
    init();
</script>
</body>
</html>
