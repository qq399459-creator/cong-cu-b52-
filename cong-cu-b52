                <tbody>${signalRows}</tbody>
            </table>

            ${consensus ? `
            <div style="margin-top:10px; padding:8px 12px; background:rgba(0,0,0,0.3); border-radius:10px; font-size:0.75rem; color:#c0c7d4;">
                <b style="color:#fff;">Consensus:</b> Tài ${consensus.scoreA} — Xỉu ${consensus.scoreB}
                ${strongSignal ? `<br><b style="color:#fff;">Mạnh nhất:</b> ${strongSignal.name} → ${strongSignal.sym === 'T' ? 'Tài' : 'Xỉu'}` : ''}
            </div>` : ''}

            <h3>🧩 Pattern gần đây</h3>
            ${patternHtml}

            <h3>💾 Lịch sử vĩnh viễn (${totalHist} phiên)</h3>
            <div class="history-strip">${historyChips || '<span style="color:#8b94a8; font-size:0.75rem;">Chưa có lịch sử</span>'}</div>
            <div class="stats-row">
                <span>Tài: <b>${countT}</b></span>
                <span>Xỉu: <b>${countX}</b></span>
